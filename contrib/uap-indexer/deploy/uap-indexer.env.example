# Example environment file for uap-indexer.
#
#   install -o root -g uap-indexer -m 0640 \
#           uap-indexer.env.example /etc/default/uap-indexer
#
# Mode 0640 root:uap-indexer matters: this file holds the node's RPC password,
# and the service only ever needs to read it.
#
# Why here and not on the command line: every process's argv is world-readable
# through /proc/<pid>/cmdline, so `uap-indexer -rpcpassword=...` hands the
# node's credentials to any local user running `ps`. A process's environment is
# readable only by its own user and root.
#
# PRECEDENCE, in decreasing order:
#
#   1. an explicit command-line flag in the unit's ExecStart=
#   2. a variable set here
#   3. the binary's built-in default
#
# The environment is only ever used to compute a flag's *default*, so a flag
# that is actually passed always wins. Note that this cuts both ways: setting
# UAP_LISTEN here has no effect while ExecStart= still passes -listen, and
# nothing warns about it. Pick one place per setting.
#
# A value that does not parse (UAP_RPC_PORT=banana, UAP_TRUSTPROXY=yes) is
# ignored and the built-in default stands -- notably, an unparseable
# UAP_TRUSTPROXY does NOT enable proxy-header trust.
#
# This file is syntactically a systemd EnvironmentFile, not a shell script:
# KEY=value only, no `export`, no command substitution, no variable expansion.
# Values with spaces need quoting; everything else does not.
#
# Every value below is a placeholder. Replace them all.

# --- Node RPC ------------------------------------------------------------

UAP_RPC_HOST=127.0.0.1
UAP_RPC_PORT=33665

# Cookie auth is preferable to a static password where the node is on the same
# host: whippetd rotates the cookie on every restart, and there is no secret to
# store here at all. It takes precedence over the user/password pair below.
# The service's user needs read access to it -- typically by being a member of
# the group that owns whippetd's data directory.
#UAP_RPC_COOKIEFILE=/var/lib/whippetd/.cookie

# Otherwise, credentials matching the node's rpcuser/rpcpassword (or an
# rpcauth= line) in whippet.conf. THESE ARE FAKE. Generate a real password
# with something like `openssl rand -base64 32` and never reuse one.
UAP_RPC_USER=CHANGEME-rpc-user
UAP_RPC_PASSWORD=CHANGEME-not-a-real-password

# --- Service ---------------------------------------------------------------
# Commented out because the shipped unit passes these as flags, where they are
# visible to anyone reading the unit -- which is the right trade for settings
# that are not secret. Uncomment here only if the corresponding flag is also
# removed from ExecStart=, or the flag will silently win.

# Loopback only; nginx faces the internet. See nginx-uap-indexer.conf.
#UAP_LISTEN=127.0.0.1:8961

# Must live under the unit's StateDirectory= (or a path added to
# ReadWritePaths=), since ProtectSystem=strict makes everything else read-only.
#UAP_STATEFILE=/var/lib/uap-indexer/uap-index.sqlite

# Derive the client IP from X-Forwarded-For/X-Real-IP instead of the connecting
# address. Set this ONLY when a reverse proxy in front of this process
# overwrites both headers -- an nginx block that merely forwards the client's
# copy makes every rate-limit and abuse control trivially evadable. Accepts
# ParseBool spellings (true/false, 1/0, t/f); "yes" is not one of them and is
# ignored.
#UAP_TRUSTPROXY=true
